SCENE my_scene
BEGIN
    OBJECT testBall
    (
        MODEL = SPHERE,
        LOCATION = (-1, 1, 1),
        DYNAMIC = TRUE,
        COLOR = 
        {
            RED: 5%, BLUE: 10%, GREEN: 90%
        }
    )
    
    OBJECT my_cube
    (
        MODEL = CUBE,
        LOCATION = (1, 5, 1),
        COLOR = 
        {
            RED: 5%,
            GREEN: 5%,
            BLUE: 20%
        },
        DYNAMIC=FALSE
    )
END